# Copy to .env.production on the server. Do not commit the completed file.
# Origin only: no trailing slash and no /api. Include :PORT if HTTP_PORT is not 80.
PUBLIC_ORIGIN=http://IP_PUBLICO
HTTP_PORT=80

MYSQL_USER=ingressoplus
MYSQL_DATABASE=ingressoplus
# Required: generate independent passwords. Single-quote values containing $ or #.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Required: persistent session key and Fernet vault key. See docs/DEPLOY_AWS.md.
SECRET_KEY=
COFRE_SECRET_KEY=

# Production Compose keeps MODO_DEMONSTRACAO=true to preserve simulated payments.
# Gemini is optional; local recommendations work without an API key.
USAR_GEMINI=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
